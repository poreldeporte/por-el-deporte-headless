# Copy to .env for local development. `npx shopify hydrogen env pull` fills in
# everything except PUBLIC_CHECKOUT_DOMAIN, which is NOT stored in Oxygen and has
# to be set by hand in both places.

PUBLIC_STORE_DOMAIN=por-el-deporte.myshopify.com
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
SESSION_SECRET=
SHOP_ID=

# REQUIRED FOR ANALYTICS.
# Hydrogen's Analytics.Provider needs this to load Shopify's Customer Privacy
# API. Without it the provider throws "consent.checkoutDomain is required" and
# no commerce event (page_viewed, product_viewed, cart_viewed) is ever recorded
# — only the performance beacon, which is why the admin looked like it was
# collecting something. This was missing from Oxygen production until 2026-08-10.
PUBLIC_CHECKOUT_DOMAIN=checkout.poreldeporte.com

# Optional. Meta (Facebook) pixel id from Events Manager > Data Sources.
# Numeric, e.g. 1234567890123456. With it unset the pixel never loads and the
# site behaves exactly as before, which is the right state for a local clone.
# The Facebook & Instagram channel's own pixel only covers the old online store
# theme, not this storefront, so it has to be set here as well.
PUBLIC_META_PIXEL_ID=

# Optional. Needed only by /api/newsletter, which subscribes an address via the
# Admin API. Requires the write_customers scope. Signup fails cleanly without it.
PRIVATE_ADMIN_API_TOKEN=

# Needed by the contact form at /app. Create a sending-only Resend API key and
# verify poreldeporte.com in Resend before using a @poreldeporte.com sender.
PRIVATE_RESEND_API_KEY=
PRIVATE_CONTACT_TO_EMAIL=contact@poreldeporte.com
PRIVATE_CONTACT_FROM_EMAIL="Por El Deporte Website <website@poreldeporte.com>"
